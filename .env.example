# ==============================================================================
# AI vs ASLI — Zenith School of AI
# Environment Variables Configuration Template
# ==============================================================================

# Flask Production Security (Required in production)
# You can set any random string here, or let Render generate one automatically
SECRET_KEY=zenith-ai-vs-asli-production-secret-key-2026

# Flask Debug Mode (Set to False in production)
FLASK_DEBUG=False

# Official Social & Website URLs
ZENITH_INSTAGRAM_URL=https://www.instagram.com/zenith_school_of_ai?utm_source=ig_web_button_share_sheet&mdxt=ZDNlZDc0MzIxNw==
CAMPAIGN_URL=https://zenithschool.ai/
ZENITH_WEBSITE_URL=https://zenithschool.ai/

# Database Path (Optional: defaults to instance/app.db)
# DATABASE_PATH=instance/app.db

# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000
